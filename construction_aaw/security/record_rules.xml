<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Record rule: users see ÄTAs only for their assigned projects -->
        <record id="rule_construction_aaw_project_user" model="ir.rule">
            <field name="name">ÄTA: own projects</field>
            <field name="model_id" ref="model_construction_aaw"/>
            <field name="domain_force">[
                '|',
                ('project_id.user_id', '=', user.id),
                ('user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record rule: users see order lines for their ÄTAs -->
        <record id="rule_construction_aaw_line_user" model="ir.rule">
            <field name="name">ÄTA Lines: own projects</field>
            <field name="model_id" ref="model_construction_aaw_line"/>
            <field name="domain_force">[
                '|',
                ('aaw_id.project_id.user_id', '=', user.id),
                ('aaw_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Field-level security via groups: only managers can edit financial fields -->
        <!-- This is handled via view-level attrs rather than ir.model.access -->

    </data>
</odoo>
