<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Surcharge Template Tree -->
    <record id="view_construction_aaw_surcharge_template_tree" model="ir.ui.view">
        <field name="name">construction.aaw.surcharge.template.tree</field>
        <field name="model">construction.aaw.surcharge.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="surcharge_percent"/>
                <field name="company_id" optional="hide"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Surcharge Template Form -->
    <record id="view_construction_aaw_surcharge_template_form" model="ir.ui.view">
        <field name="name">construction.aaw.surcharge.template.form</field>
        <field name="model">construction.aaw.surcharge.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="surcharge_percent" required="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
