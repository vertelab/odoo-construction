<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- === ÄTA Tree View === -->
    <record id="view_construction_aaw_tree" model="ir.ui.view">
        <field name="name">construction.aaw.tree</field>
        <field name="model">construction.aaw</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'"
                  decoration-success="state in ('approved', 'done')"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="aaw_type" optional="show"/>
                <field name="compensation_method" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('approved','done')"
                       decoration-warning="state == 'submitted'" decoration-info="state == 'draft'"
                       decoration-danger="state == 'rejected'" decoration-muted="state in ('closed','cancelled')"/>
                <field name="estimated_amount" sum="Total Estimated" optional="show"/>
                <field name="offer_amount" sum="Total Offer" optional="show"/>
                <field name="agreed_amount" optional="hide"/>
                <field name="user_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- === ÄTA Form View === -->
    <record id="view_construction_aaw_form" model="ir.ui.view">
        <field name="name">construction.aaw.form</field>
        <field name="model">construction.aaw</field>
        <field name="arch" type="xml">
            <form string="ÄTA">
                <header>
                    <button name="action_submit" type="object" string="Submit to Customer"
                            states="draft" class="btn-primary"/>
                    <button name="action_approve" type="object" string="Approve"
                            states="submitted" class="btn-success"/>
                    <button name="action_reject" type="object" string="Reject"
                            states="submitted" class="btn-danger"/>
                    <button name="action_start_work" type="object" string="Start Work"
                            states="approved" class="btn-primary"/>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            states="in_progress" class="btn-success"/>
                    <button name="action_invoice" type="object" string="Create Invoice"
                            states="done" class="btn-primary"/>
                    <button name="action_close" type="object" string="Close"
                            states="invoiced" class="btn-secondary"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            states="submitted" class="btn-secondary"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            states="draft,submitted" class="btn-secondary"/>
                    <button name="action_request_signature" type="object" string="Request Signature"
                            icon="fa-pencil-square-o"
                            states="draft,submitted,approved"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,done,invoiced,closed"/>
                </header>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_sign_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            attrs="{'invisible': [('sign_request_count', '=', 0)]}">
                        <field name="sign_request_count" widget="statinfo" string="Signatures"/>
                    </button>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" required="1"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="partner_contact_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="aaw_type" required="1"/>
                            <field name="compensation_method" required="1"/>
                            <field name="surcharge_template_id"/>
                            <field name="hide_surcharge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="uom_id"/>
                                    <field name="estimated_quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="cost_per_unit" widget="monetary"/>
                                    <field name="surcharge_percent"/>
                                    <field name="surcharge_amount" widget="monetary"/>
                                    <field name="offer_amount" widget="monetary" sum="Total Offer"/>
                                    <field name="billable"/>
                                    <field name="executed_quantity"/>
                                    <field name="sold_quantity"/>
                                    <field name="executed_date"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Financials">
                            <group>
                                <group>
                                    <field name="estimated_amount" widget="monetary"/>
                                    <field name="surcharge_amount" widget="monetary"/>
                                    <field name="offer_amount" widget="monetary"/>
                                    <field name="agreed_amount" widget="monetary"/>
                                </group>
                                <group>
                                    <field name="cost_total" widget="monetary"/>
                                    <field name="revenue_total" widget="monetary"/>
                                    <field name="uninvoiced_amount" widget="monetary"/>
                                    <field name="is_invoiced"/>
                                </group>
                            </group>
                            <field name="invoice_ids" widget="many2many_tags"/>
                        </page>
                        <page string="ABT06">
                            <group>
                                <group>
                                    <field name="notification_date"/>
                                    <field name="written_order_date"/>
                                    <field name="approved_date"/>
                                    <field name="completed_date"/>
                                    <field name="invoice_date"/>
                                    <field name="closed_date"/>
                                </group>
                                <group>
                                    <field name="time_extension_days"/>
                                    <field name="time_extension_approved"/>
                                    <field name="customer_approved"/>
                                    <field name="customer_comment"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tasks">
                            <field name="task_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="user_id"/>
                                    <field name="date_deadline"/>
                                    <field name="planned_hours"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Internal Notes">
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- === ÄTA Search View === -->
    <record id="view_construction_aaw_search" model="ir.ui.view">
        <field name="name">construction.aaw.search</field>
        <field name="model">construction.aaw</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="description"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('state', 'not in', ('closed', 'cancelled', 'rejected'))]"/>
                <filter name="filter_aaw_type" string="ÄTA Type" context="{'group_by': 'aaw_type'}"/>
                <filter name="filter_compensation" string="Compensation" context="{'group_by': 'compensation_method'}"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- === ÄTA Kanban View === -->
    <record id="view_construction_aaw_kanban" model="ir.ui.view">
        <field name="name">construction.aaw.kanban</field>
        <field name="model">construction.aaw</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="aaw_type"/>
                <field name="offer_amount"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click {{ record.state.raw_value == 'draft' and 'o_kanban_record_draft' or '' }} {{ record.state.raw_value == 'rejected' and 'o_kanban_record_rejected' or '' }}">
                            <div class="o_kanban_card_header">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <field name="state" widget="badge"/>
                            </div>
                            <div class="o_kanban_card_content">
                                <div><t t-esc="record.project_id.value"/></div>
                                <div><t t-esc="record.partner_id.value"/></div>
                                <div>Type: <t t-esc="record.aaw_type.value"/></div>
                                <div class="text-muted">
                                    Offer: <field name="offer_amount" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
